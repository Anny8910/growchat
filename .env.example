# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env
#
# Only GROQ_API_KEY is required, and only from Phase 5 onward. Phases 1-4
# run with no key at all.

# --- Required (Phase 5+) ----------------------------------------------------
# https://console.groq.com/keys  — free tier is enough for this project.
GROQ_API_KEY=

# --- Optional overrides -----------------------------------------------------
# Every value below is also the built-in default, so an empty .env is valid:
# an empty assignment falls back to the default in config.py. Delete a line to
# remove the override.

# Free-tier model availability rotates; verify the id before the demo.
GROQ_MODEL=

# Chunking — frozen by docs/CHUNKING.md. 150 words is ~200 tokens, under
# MiniLM's 256-token limit, so nothing is silently truncated.
# CHUNK_WORDS=150
# CHUNK_OVERLAP=25

# Retrieval — k=5 and the cosine threshold, frozen from the Phase 5
# measurements: good matches land at 0.138-0.374, off-topic questions at
# 0.823+, so 0.45 separates them with margin.
# TOP_K=5
# DISTANCE_THRESHOLD=0.45

# Conversation memory — how many recent messages (a question and its answer
# count as two) are kept in RAM to resolve follow-ups. Held in-process only and
# never written to disk, so a restart starts a fresh conversation.
# CONVERSATION_MESSAGES=10

# Generation — temperature 0 for factual determinism. max_tokens is 1024, not
# the ~250 an answer needs, because the model is a reasoning model whose
# reasoning tokens count against this budget; too small a value returns
# truncated answers. The 3-sentence cap is enforced by validate_output, not by
# this number.
# GROQ_TEMPERATURE=0.0
# GROQ_MAX_TOKENS=1024
